<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_space_dark">

    <!-- TOP HEADER BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: Signal Bars Indicator -->
        <ImageView
            android:id="@+id/ivSignalBars"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_signal_bars"
            android:contentDescription="@string/desc_signal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Center: Luna-X Title ("LUNA" in white, "-MX" in neon red) -->
        <LinearLayout
            android:id="@+id/boxLunaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvTitleLuna"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title_Luna"
                android:textColor="@color/text_luna_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/tvTitleSuffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title_mx"
                android:textColor="@color/luna_red"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <!-- Right: Telemetry data + Settings Gear (Matching luna.mp4 00:16) -->
        <LinearLayout
            android:id="@+id/layoutRightHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/layoutTelemetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tvTelemetryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="17:01:11"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvTelemetryCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28.6192° N"
                    android:textColor="@color/luna_red"
                    android:textSize="8sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings_title"
                app:tint="@color/luna_red" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Glowing Orange Divider Line -->
    <View
        android:id="@+id/viewHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1.2dp"
        android:background="@color/divider_orange"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CENTER ARC REACTOR HUD CONTAINER (1:1 Ratio for circular Arc Reactor) -->
    <FrameLayout
        android:id="@+id/orbContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/viewHeaderDivider"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webViewOrb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

    </FrameLayout>

    <!-- DEEP RESEARCH AGENT HUD OVERLAY -->
    <include
        android:id="@+id/layoutResearchHud"
        layout="@layout/layout_deep_research_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewHeaderDivider"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FULL SCREEN CAMERA & VISUALIZATION VIEW -->
    <TextureView
        android:id="@+id/cameraPreviewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewHeaderDivider"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Vision Mode HUD Badge -->
    <LinearLayout
        android:id="@+id/layoutVisionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_toggle"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/viewHeaderDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvVisionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VISION DUAL-FEED"
            android:textColor="@color/luna_orange"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1" />

        <ImageButton
            android:id="@+id/btnSwitchLens"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_camera_switch"
            android:contentDescription="Switch Camera Lens"
            app:tint="@color/luna_orange" />
    </LinearLayout>

    <!-- CALL CONTROL ROW: Clean, uniform UI alignment (Hidden during normal assistant flow) -->
    <LinearLayout
        android:id="@+id/layoutCallControlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|center_horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_pill_toggle"
        android:layout_marginBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Pick Up / Call Button -->
        <ImageButton
            android:id="@+id/btnCallAnswer"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_action_circle_green"
            android:src="@drawable/ic_call"
            android:contentDescription="Answer / Make Call"
            app:tint="#FFFFFF"
            android:layout_marginEnd="16dp" />

        <!-- 2. Hang Up / End Call Button -->
        <ImageButton
            android:id="@+id/btnCallEnd"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_action_circle_red"
            android:src="@drawable/ic_call_end"
            android:contentDescription="Hang Up / End Call"
            app:tint="#FFFFFF"
            android:layout_marginEnd="16dp" />

        <!-- 3. Speaker Mode Button -->
        <ImageButton
            android:id="@+id/btnCallSpeaker"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_action_circle_dark"
            android:src="@drawable/ic_speaker"
            android:contentDescription="Speakerphone"
            app:tint="@color/luna_orange"
            android:layout_marginEnd="16dp" />

        <!-- 4. Mute Audio Button -->
        <ImageButton
            android:id="@+id/btnCallMute"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_action_circle_dark"
            android:src="@drawable/ic_mic_off"
            android:contentDescription="Mute Audio"
            app:tint="@color/luna_orange" />

    </LinearLayout>

    <!-- BOTTOM SCI-FI CONTROLS BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: Eye Vision Button -->
        <ImageButton
            android:id="@+id/btnEye"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_eye"
            android:contentDescription="@string/desc_eye"
            app:tint="@color/luna_orange"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Center: AI ON/OFF Slide-To-Power Bar (Slide Left-to-Right to Start, Right-to-Left to Stop) -->
        <FrameLayout
            android:id="@+id/layoutPowerToggle"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_pill_toggle"
            app:layout_constraintStart_toEndOf="@+id/btnEye"
            app:layout_constraintEnd_toStartOf="@+id/btnMic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- STATE A TEXT: OFFLINE (Slide to start >>>) -->
            <LinearLayout
                android:id="@+id/layoutSlideTextOffline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="54dp"
                android:paddingEnd="16dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvSlideOfflineTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_offline"
                    android:textColor="@color/text_luna_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/tvSlideOfflineHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slide_to_start"
                    android:textColor="@color/luna_red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- STATE B TEXT: ONLINE (<<< Slide to stop) -->
            <LinearLayout
                android:id="@+id/layoutSlideTextOnline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="54dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSlideOnlineTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_online"
                    android:textColor="@color/luna_red"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/tvSlideOnlineHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slide_to_stop"
                    android:textColor="@color/luna_red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- SLIDING THUMB (Interactive drag handle) -->
            <FrameLayout
                android:id="@+id/sliderThumb"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_action_circle_orange"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSliderThumbIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_call"
                    android:importantForAccessibility="no"
                    app:tint="#FFFFFF" />
            </FrameLayout>

        </FrameLayout>

        <!-- Right: Mic Button -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/desc_mute_mic"
            app:tint="@color/luna_orange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
