{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LunaEvent",
  "description": "Schema for internal typed events across LUNA AI runtime, AI core, and UI layers.",
  "type": "object",
  "properties": {
    "event": {
      "type": "string",
      "description": "Event type identifier",
      "enum": [
        "user_command",
        "voice_started",
        "voice_stopped",
        "wake_word_detected",
        "screen_updated",
        "camera_updated",
        "app_opened",
        "app_closed",
        "window_changed",
        "tool_started",
        "tool_completed",
        "tool_failed",
        "memory_created",
        "memory_retrieved",
        "ai_started",
        "ai_stopped",
        "session_state_changed",
        "error_occurred"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of event generation"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "user_id": {
      "type": "string",
      "description": "Unique identifier of the interacting user"
    },
    "intent": {
      "type": "string",
      "description": "Resolved intent (e.g. open_application, play_media, web_search)"
    },
    "command": {
      "type": "string",
      "description": "Original raw command text"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score of intent detection"
    },
    "requires_confirmation": {
      "type": "boolean",
      "default": false,
      "description": "True if the event triggers a high-risk operation requiring explicit confirmation"
    },
    "payload": {
      "type": "object",
      "description": "Arbitrary typed payload specific to the event type"
    }
  },
  "required": ["event", "timestamp", "session_id"]
}
