{
  "environment": "staging",
  "log_level": "DEBUG",
  "ai": {
    "default_model": "gemini-2.5-flash-native-audio-preview-12-2025",
    "bidi_ws_url": "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContent",
    "keepalive_interval_sec": 30,
    "max_session_duration_minutes": 9
  },
  "voice": {
    "input_sample_rate": 16000,
    "output_sample_rate": 24000,
    "inactivity_sleep_timeout_sec": 60,
    "default_voice": "Aoede",
    "wake_words": ["hey luna", "luna", "wake up luna", "utho luna"]
  },
  "runtime": {
    "local_command_timeout_ms": 2000,
    "fast_router_target_ms": 200,
    "enable_memory": true,
    "enable_screen_capture": true,
    "enable_camera_vision": true
  }
}
