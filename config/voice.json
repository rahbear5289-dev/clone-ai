{
  "engine": "gemini_live",
  "default_voice": "Aoede",
  "available_voices": ["Aoede", "Puck", "Charon", "Kore", "Fenrir"],
  "sample_rates": {
    "microphone_in": 16000,
    "playback_out": 24000
  },
  "wake_word": {
    "engine": "vosk",
    "model_path": "model-en-us",
    "phrases": [
      "hey luna",
      "luna",
      "wake up luna",
      "utho luna",
      "luna wake up",
      "hello luna"
    ],
    "sensitivity": 0.75,
    "inactivity_sleep_timeout_sec": 60
  },
  "speech_policy": {
    "single_voice_enforced": true,
    "allow_accessibility_tts_fallback": false,
    "suppress_mic_during_playback": true
  }
}
